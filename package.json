{
  "name": "wo-tienda",
  "version": "0.1.0",
  "private": true,
  "description": "Wo! — Tienda online de accesorios para iPhone. Rafaela, Santa Fe.",
  "scripts": {
    "css": "sass scss/main.scss css/main.css --style=expanded --source-map",
    "css:watch": "sass --watch scss/main.scss css/main.css --style=expanded --source-map",
    "build": "sass scss/main.scss css/main.css --style=compressed --no-source-map",
    "serve": "python -m http.server 5500",
    "dev": "npm run css && npm run serve"
  },
  "devDependencies": {
    "sass": "^1.98.0"
  }
}
